{
	"name": "mariettaviolinwithcarla-com",
	"type": "module",
	"version": "1.6.6",
	"private": true,
	"packageManager": "npm@12.2.2",
	"engines": {
		"node": ">=26.13.0 <27",
		"npm": ">=12.2.2 <13"
	},
	"description": "Static studio and lesson-request site for Marietta Violin with Carla",
	"author": "Jacob Anderson",
	"license": "ISC",
	"workspaces": [
		"front-end"
	],
	"allowScripts": {
		"esbuild@0.28.2": true,
		"fsevents@2.3.3": true,
		"puppeteer@25.16.0": false,
		"simple-git-hooks@2.14.0": true,
		"unrs-resolver@1.12.2": true
	},
	"scripts": {
		"build": "npm run validate:content && npm run verify:analytics && npm run verify:retired-secrets && npm run -w front-end build",
		"dev": "npm run validate:content && npm run -w front-end dev",
		"serve": "node front-end/scripts/preview.mjs",
		"preview": "node front-end/scripts/preview.mjs",
		"postinstall": "node scripts/check-build-toolchain.mjs && node scripts/check-toolchain-package.mjs && node scripts/patch-minimatch-consumers.mjs && simple-git-hooks && npm run -w front-end prepare",
		"test": "npm run validate:content && npm run verify:analytics && npm run verify:retired-secrets && npm run -w front-end test:unit && node --test test/*.test.mjs vendor/tests/*.test.mjs && npm run test:artifact && npm run test:build-toolchain && npm run test:toolchain-package && node --test scripts/test-devtools-provider.mjs scripts/test-vue-devtools-compat.mjs && npm run test:devtools",
		"test:artifact": "python3 -B -m unittest scripts/test_static_artifact.py -v",
		"test:e2e": "node scripts/e2e-smoke.mjs",
		"lint": "npm run lint:root && npm run -w front-end lint",
		"lint:root": "eslint \"scripts/**/*.{js,mjs,cjs,ts}\" \"test/**/*.{js,mjs,cjs,ts}\" eslint.config.js",
		"lint-fix": "npm run lint:root -- --fix && npm run -w front-end lint-fix",
		"typecheck": "npm run -w front-end typecheck",
		"audit": "npm run audit:toolchain && npm audit --audit-level=low",
		"audit:production": "npm run audit:toolchain -- --omit=dev && npm audit --omit=dev --audit-level=low",
		"audit:signatures": "npm audit signatures",
		"verify:dependency-graph": "node scripts/verify-dependency-graph.mjs",
		"verify:native-lock": "node scripts/verify-native-lock.mjs",
		"verify:platform-install": "node scripts/verify-platform-install.mjs",
		"verify:analytics": "node scripts/verify-vendored-analytics.mjs",
		"verify:retired-secrets": "node scripts/verify-no-retired-secrets.mjs",
		"validate:content": "node scripts/validate-site-content.mjs",
		"verify:static": "node scripts/verify-vendored-analytics.mjs && node scripts/verify-static-output.mjs",
		"smoke:deployment": "node scripts/live-site-smoke.mjs",
		"smoke:live": "node scripts/live-site-smoke.mjs",
		"clean": "node scripts/clean.mjs",
		"up": "taze major --write && npm install --package-lock-only --ignore-scripts --no-fund --no-audit",
		"a11y": "node scripts/a11y-smoke.mjs",
		"audit:toolchain": "node scripts/audit-build-toolchain.mjs",
		"toolchain:prepare": "node scripts/build-toolchain.mjs --print-bin",
		"check:build-toolchain": "node scripts/check-build-toolchain.mjs",
		"check:toolchain-package": "node scripts/check-toolchain-package.mjs",
		"test:build-toolchain": "node --test scripts/test-build-toolchain.mjs",
		"test:devtools": "node scripts/test-vue-devtools-host.mjs",
		"test:toolchain-package": "python3 -B -m unittest discover -s scripts -p test_build_toolchain.py -v"
	},
	"devDependencies": {
		"@antfu/eslint-config": "^10.0.0",
		"@prettier/plugin-xml": "^3.4.2",
		"axe-core": "^4.14.0",
		"braces": "file:vendor/braces",
		"deepmerge": "file:vendor/deepmerge",
		"eslint": "^10.14.0",
		"eslint-plugin-format": "^2.0.1",
		"eslint-plugin-vue": "^10.12.0",
		"globals": "^17.14.0",
		"lint-staged": "^17.6.0",
		"listhen": "file:vendor/listhen",
		"prettier": "^3.9.10",
		"puppeteer": "^25.16.0",
		"simple-git-hooks": "^2.14.0",
		"srvx": "1.0.8",
		"taze": "^21.3.0",
		"typescript": "^6.0.3",
		"unplugin": "^3.7.0",
		"eslint-plugin-slop": "^0.1.3",
		"eslint-plugin-sonarjs": "^4.2.2",
		"@vitejs/devtools-kit": "0.7.6",
		"vite-plugin-vue-devtools": "9.0.0-rc.2"
	},
	"simple-git-hooks": {
		"pre-commit": "test -x ./node_modules/.bin/lint-staged || { echo 'lint-staged is not installed. Run npm install.'; exit 1; }; ./node_modules/.bin/lint-staged"
	},
	"lint-staged": {
		"front-end/**/*.{js,mjs,cjs,ts,vue}": "npm exec --workspace front-end -- eslint --fix",
		"{eslint.config.js,scripts/*.{js,mjs,cjs,ts},test/*.{js,mjs,cjs,ts}}": "eslint --fix"
	},
	"overrides": {
		"braces": "$braces",
		"deepmerge": "$deepmerge",
		"listhen": "$listhen",
		"glob": "14.0.4",
		"minimatch": "11.0.5",
		"@nuxt/devtools": "^4.1.0",
		"@nuxt/kit": "^4.6.4",
		"nuxt": "^4.6.4",
		"rollup": "4.67.5",
		"vite": "^8.3.6",
		"unplugin": "^3.7.0",
		"defu": "6.1.7",
		"picomatch@^4": "4.0.7",
		"anymatch@3.1.3": {
			"picomatch": "2.3.2"
		},
		"micromatch@4.0.8": {
			"picomatch": "2.3.2"
		},
		"readdirp@3.6.0": {
			"picomatch": "2.3.2"
		},
		"follow-redirects": "1.16.2",
		"brace-expansion": "5.0.12",
		"devalue@^5": "5.9.4",
		"fast-uri": "3.1.9",
		"serialize-javascript": "7.1.4",
		"postcss": "8.5.32",
		"qs": "6.17.1",
		"shell-quote": "1.12.0",
		"simple-git": "4.0.2",
		"compression": "1.8.2",
		"micromark-extension-math": {
			"katex": "0.18.2"
		},
		"tinypool": "2.2.0",
		"srvx": "1.0.8",
		"svgo": "4.1.0",
		"tar": "7.5.22",
		"valibot": "1.5.0",
		"nanoid@^3": "3.3.20"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": ">=26.13.0 <27",
			"onFail": "error"
		},
		"packageManager": {
			"name": "npm",
			"version": ">=12.2.2 <13",
			"onFail": "error"
		}
	}
}
