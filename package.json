{
	"name": "mariettaviolinwithcarla-monorepo",
	"type": "module",
	"version": "1.0.0",
	"private": true,
	"packageManager": "npm@11.12.0",
	"description": "Monorepo for mariettaviolinwithcarla.com",
	"author": "Jacob Anderson",
	"license": "ISC",
	"workspaces": [
		"front-end",
		"back-end"
	],
	"scripts": {
		"build": "npm run -w front-end build && npm run -w back-end build",
		"dev": "npm run -w front-end dev",
		"server": "npm run -w back-end server",
		"serve": "npm run -w front-end serve",
		"lint-server": "npm run -w back-end lint-fix && npm run -w back-end server",
		"lint-serve": "npm run -w front-end lint-fix && npm run -w front-end serve",
		"lint": "npm run -w front-end lint && npm run -w back-end lint",
		"lint-fix": "npm run -w front-end lint-fix && npm run -w back-end lint-fix",
		"typecheck": "npm run -w front-end typecheck && npm run -w back-end typecheck",
		"clean": "sudo rm -rf node_modules dist package-lock.json **/node_modules **/dist **/package-lock.json **/.nuxt **/.output",
		"up": "taze major -I && npm run -w front-end up && npm run -w back-end up"
	},
	"devDependencies": {
		"@antfu/eslint-config": "^7.7.3",
		"@typescript-eslint/eslint-plugin": "^8.58.0",
		"@typescript-eslint/parser": "^8.58.0",
		"eslint": "^10.1.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.5",
		"eslint-plugin-vue": "^10.8.0",
		"globals": "^17.4.0",
		"prettier": "^3.8.1",
		"taze": "^19.11.0",
		"typescript": "^5.9.3"
	},
	"overrides": {
		"qs": "6.15.0",
		"nodemailer": "8.0.5",
		"defu": "6.1.6",
		"path-to-regexp": "8.4.0",
		"node-forge": "1.4.0",
		"srvx": "0.11.13",
		"picomatch": "4.0.4",
		"anymatch": {
			"picomatch": "2.3.2"
		},
		"micromatch": {
			"picomatch": "2.3.2"
		},
		"readdirp": {
			"picomatch": "2.3.2"
		},
		"eslint-plugin-import": {
			"minimatch": "^3.1.5"
		},
		"@vue/language-core": {
			"minimatch": "^9.0.9"
		}
	}
}
