{
	"name": "mariettaviolinwithcarla-com",
	"type": "module",
	"version": "1.4.2",
	"private": true,
	"packageManager": "npm@12.0.2",
	"engines": {
		"node": ">=24.18.1 <25",
		"npm": ">=12.0.2 <13"
	},
	"description": "Static studio and lesson-request site for Marietta Violin with Carla",
	"author": "Jacob Anderson",
	"license": "ISC",
	"workspaces": [
		"front-end"
	],
	"allowScripts": {
		"cypress@15.19.0": true,
		"esbuild@0.28.1": true,
		"fsevents@2.3.3": true,
		"puppeteer@25.4.0": false,
		"simple-git-hooks@2.13.1": true,
		"unrs-resolver@1.12.2": true
	},
	"scripts": {
		"build": "npm run -w front-end build",
		"dev": "npm run -w front-end dev",
		"serve": "node front-end/scripts/preview.mjs",
		"preview": "node front-end/scripts/preview.mjs",
		"postinstall": "simple-git-hooks && npm run -w front-end prepare",
		"test": "npm run -w front-end test:unit && node --test test/*.test.mjs",
		"test:e2e": "npm run -w front-end test:e2e",
		"lint": "npm run lint:root && npm run -w front-end lint",
		"lint:root": "eslint \"scripts/**/*.{js,mjs,cjs,ts}\" \"test/**/*.{js,mjs,cjs,ts}\" eslint.config.js",
		"lint-fix": "npm run lint:root -- --fix && npm run -w front-end lint-fix",
		"typecheck": "npm run -w front-end typecheck",
		"audit": "npm audit --audit-level=low",
		"audit:production": "npm audit --omit=dev --audit-level=low",
		"audit:signatures": "npm audit signatures",
		"verify:dependency-graph": "node scripts/verify-dependency-graph.mjs",
		"verify:native-lock": "node scripts/verify-native-lock.mjs",
		"verify:platform-install": "node scripts/verify-platform-install.mjs",
		"verify:static": "node scripts/verify-static-output.mjs",
		"smoke:deployment": "node scripts/live-site-smoke.mjs",
		"smoke:live": "node scripts/live-site-smoke.mjs",
		"clean": "node scripts/clean.mjs",
		"up": "taze major --write && npm install --package-lock-only --ignore-scripts --no-fund --no-audit",
		"a11y": "node scripts/a11y-smoke.mjs"
	},
	"devDependencies": {
		"@antfu/eslint-config": "^9.3.0",
		"axe-core": "^4.13.0",
		"eslint": "^10.8.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-format": "^2.0.1",
		"eslint-plugin-prettier": "^5.5.6",
		"eslint-plugin-vue": "^10.10.0",
		"globals": "^17.8.0",
		"lint-staged": "^17.3.0",
		"prettier": "^3.9.6",
		"puppeteer": "^25.5.0",
		"simple-git-hooks": "^2.13.1",
		"taze": "^19.16.0",
		"typescript": "^6.0.3"
	},
	"simple-git-hooks": {
		"pre-commit": "test -x ./node_modules/.bin/lint-staged || { echo 'lint-staged is not installed. Run npm install.'; exit 1; }; ./node_modules/.bin/lint-staged"
	},
	"lint-staged": {
		"front-end/**/*.{js,mjs,cjs,ts,vue}": "npm exec --workspace front-end -- eslint --fix",
		"{eslint.config.js,scripts/*.{js,mjs,cjs,ts},test/*.{js,mjs,cjs,ts}}": "eslint --fix"
	},
	"overrides": {
		"archiver-utils": {
			"glob": "13.0.6"
		},
		"@nuxt/devtools": "^3.4.0",
		"@nuxt/kit": "^4.5.1",
		"nuxt": "^4.5.1",
		"rollup": "4.62.4",
		"vite": "^8.2.0",
		"unplugin": "^3.3.0",
		"defu": "6.1.6",
		"picomatch@^4": "4.0.4",
		"anymatch@3.1.3": {
			"picomatch": "2.3.2"
		},
		"micromatch@4.0.8": {
			"picomatch": "2.3.2"
		},
		"readdirp@3.6.0": {
			"picomatch": "2.3.2"
		},
		"follow-redirects": "1.16.0",
		"brace-expansion": "5.0.9",
		"fast-uri": "3.1.5",
		"js-yaml": "4.3.1",
		"nanoid": "3.3.18",
		"node-forge": "1.4.0",
		"postcss": "8.5.24",
		"qs": "6.15.3",
		"shell-quote": "1.10.0",
		"simple-git": "3.36.0",
		"srvx": "0.11.13",
		"svgo": "4.0.2",
		"tar": "7.5.22",
		"valibot": "1.4.2"
	}
}
