{
	"name": "mariettaviolinwithcarla-front-end",
	"type": "module",
	"version": "1.6.0",
	"private": true,
	"packageManager": "npm@12.0.2",
	"engines": {
		"node": ">=24.18.1 <25",
		"npm": ">=12.0.2 <13"
	},
	"scripts": {
		"build": "nuxt generate && node ../scripts/write-deployment-metadata.mjs && node ../scripts/prepare-static-output.mjs && node ../scripts/verify-static-output.mjs",
		"dev": "nuxt dev --host 127.0.0.1 --port 3333",
		"generate": "nuxt generate",
		"prepare": "nuxt prepare",
		"preview": "node ./scripts/preview.mjs",
		"serve": "node ./scripts/preview.mjs",
		"start": "node ./scripts/preview.mjs",
		"lint": "eslint .",
		"lint-fix": "eslint . --fix",
		"typecheck": "nuxt typecheck",
		"test:unit": "node --test --import tsx test/*.test.ts",
		"test:e2e": "node ../scripts/e2e-smoke.mjs",
		"up": "taze major -I"
	},
	"dependencies": {
		"pinia": "^4.0.3",
		"vue": "^3.5.43"
	},
	"optionalDependencies": {
		"@esbuild/linux-arm64": "0.28.2",
		"@esbuild/linux-x64": "0.28.2",
		"@oxc-parser/binding-linux-arm64-gnu": "0.150.0",
		"@oxc-parser/binding-linux-arm64-musl": "0.150.0",
		"@oxc-parser/binding-linux-x64-gnu": "0.150.0",
		"@oxc-parser/binding-linux-x64-musl": "0.150.0",
		"@oxfmt/binding-linux-arm64-gnu": "0.35.0",
		"@oxfmt/binding-linux-arm64-musl": "0.35.0",
		"@oxfmt/binding-linux-x64-gnu": "0.35.0",
		"@oxfmt/binding-linux-x64-musl": "0.35.0",
		"@rolldown/binding-linux-arm64-gnu": "1.2.9",
		"@rolldown/binding-linux-arm64-musl": "1.2.9",
		"@rolldown/binding-linux-x64-gnu": "1.2.9",
		"@rolldown/binding-linux-x64-musl": "1.2.9",
		"@rollup/rollup-linux-arm64-gnu": "4.63.4",
		"@rollup/rollup-linux-arm64-musl": "4.63.4",
		"@rollup/rollup-linux-x64-gnu": "4.63.4",
		"@rollup/rollup-linux-x64-musl": "4.63.4",
		"@unrs/resolver-binding-linux-arm64-gnu": "1.12.2",
		"@unrs/resolver-binding-linux-arm64-musl": "1.12.2",
		"@unrs/resolver-binding-linux-x64-gnu": "1.12.2",
		"@unrs/resolver-binding-linux-x64-musl": "1.12.2",
		"lightningcss-linux-arm64-gnu": "1.33.0",
		"lightningcss-linux-arm64-musl": "1.33.0",
		"lightningcss-linux-x64-gnu": "1.33.0",
		"lightningcss-linux-x64-musl": "1.33.0"
	},
	"devDependencies": {
		"@iconify-json/carbon": "^1.2.27",
		"@iconify-json/twemoji": "^1.2.5",
		"@nuxt/eslint": "^1.17.0",
		"@nuxtjs/color-mode": "^4.0.1",
		"@pinia/nuxt": "^1.0.2",
		"@types/node": "^24.13.6",
		"@unocss/eslint-config": "^66.10.5",
		"@unocss/nuxt": "^66.10.5",
		"@vitejs/plugin-vue": "^6.0.9",
		"nuxt": "^4.5.2",
		"rollup": "^4.63.4",
		"serve": "^14.2.6",
		"terser": "^5.51.2",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.70.1",
		"unocss": "^66.10.5",
		"unplugin": "^3.4.0",
		"vite": "^8.3.0",
		"vue-eslint-parser": "^10.4.1",
		"vue-tsc": "^3.3.11"
	}
}
